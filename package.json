{
  "name": "chowkra-server",
  "version": "1.0.0",
  "description": "Real-time multiplayer server for Chowkra (Chowka Bara)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --watch src/index.js",
    "test": "node --no-warnings --test --test-force-exit test/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
